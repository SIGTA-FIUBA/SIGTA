      "$type": "number",
      "$value": 7,
      "$description": "fiuba.7, that is action.600."
    },
    "dimmedShade": {
      "$type": "number",
      "$value": 7,
      "$description": "Gray shade of dimmed text (c=\"dimmed\"): ink.600, the secondary text. Metadata uses c=\"gray.6\"."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter Variable", "Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "The typeface of the interface: Inter, variable, served by the site itself (@fontsource-variable/inter), so it looks the same on every system. To be agreed with Comunicación Institucional: the FIUBA manual sets Helvetica Neue (A.6)."
      },
      "mono": {
        "$value": [
          "ui-monospace",
