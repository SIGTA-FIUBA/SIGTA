        "$value": "#0088CC",
        "$description": "Institutional cyan, Pantone 2394 C. 3.9:1 on white: only for marks and large shapes."
      },
      "50": {
        "$value": "#E5F3FA",
        "$description": "Tint of the cyan: the selected item and the avatar."
      }
