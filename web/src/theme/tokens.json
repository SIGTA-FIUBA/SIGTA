      },
      "brand": {
        "$value": ["Helvetica Neue", "Helvetica", "Arial", "sans-serif"],
        "$description": "The institutional typeface (manual A.6), only in the joint signature with FIUBA and institutional pieces. Arial is the accepted replacement (B.4)."
